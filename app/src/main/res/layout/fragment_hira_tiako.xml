<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hira_tiako_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <!-- 1. DIRECT HEADER ON BACKGROUND (Same style as Fandraisana greeting) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/tv_hira_tiako_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="-0.02"
            android:text="HIRA TIAKO"
            android:textAllCaps="true"
            android:textColor="@color/primary_container"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_hira_tiako_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:text="Ireo hira ankafizina manokana ao amin'ny fihirana"
            android:textColor="@color/on_surface_variant"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 3 FILTER CHIPS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <!-- 3 Filter Chips Capsule (Rehetra / Fihirana lehibe / Fanampiny) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <!-- Chip 1: Rehetra -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_all"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/chip_active_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_all"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_auto_stories"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_fav_chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Rehetra"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip 2: Fihirana lehibe -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_lehibe"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_lehibe"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_music_note"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_fav_chip_lehibe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Fihirana lehibe"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Chip 3: Fanampiny -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/chip_fav_fanampiny"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/hikaroka_pill_bg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/icon_fav_chip_fanampiny"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_queue_music"
                            app:tint="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tv_fav_chip_fanampiny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:maxLines="1"
                            android:text="Fanampiny"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- 2. SUB-HEADER / SUMMARY PILL & QUICK METRICS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_section_indicator" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="0.06"
            android:text="LISITRA VOATAHIRY"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_heart"
                    app:tint="@color/primary_container" />

                <TextView
                    android:id="@+id/tv_hira_tiako_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="0 hira voatahiry"
                    android:textColor="@color/primary_container"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Empty State Solid Bento Card (Quand la liste des favoris est vide) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_favorites_empty_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/surface_container_lowest"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/border_eae0e2"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardBackgroundColor="@color/pill_btn_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bookmark_heart"
                    app:tint="@color/primary_container" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_empty_favorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Tsy mbola misy hira voatahiry, ireo hira ankafizinao manokana no ato"
                android:textColor="@color/on_surface_variant"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3. FAVORITES LIST (iOS 18 Solid Bento Cards List) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_favorite_songs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="108dp"
        android:visibility="gone" />

</LinearLayout>
