<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_song_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/fav_btn_bg"
    app:strokeColor="@color/border_eae0e2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: circular number badge + collection label + circular favorite button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/primary_container"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <TextView
                    android:id="@+id/tv_song_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/on_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_song_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Fihirana Lehibe"
                android:textColor="@color/on_surface_variant"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_favorite_btn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/fav_btn_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">

                <ImageButton
                    android:id="@+id/btn_favorite_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Tahiry hira"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/primary_container" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Center row: Uppercase Bold Song Title -->
        <TextView
            android:id="@+id/tv_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="@font/plus_jakarta_sans"
            android:letterSpacing="-0.01"
            android:text="ANDRIAMANITRA FITIAVANA"
            android:textAllCaps="true"
            android:textColor="@color/primary_container"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Bottom row: Italic preview quote + "Hamaky >" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/tv_song_preview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:text="“Andriamanitra fitiavana izao tontolo izao...”"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tv_song_read_cta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans"
                android:text="Hamaky &gt;"
                android:textColor="@color/primary_container"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
