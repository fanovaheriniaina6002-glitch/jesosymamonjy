<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trakta_reader_screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP APP BAR / PILL HEADER (0% blur / 60 FPS Solid Bento) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="999dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_eae0e2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- Back Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_trakta_reader_back"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/pill_btn_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#EAE0E2"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Miverina"
                            android:src="@drawable/ic_arrow_back_ios"
                            app:tint="@color/primary_container" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Brand Title & Subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/tv_trakta_reader_top_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.06"
                            android:maxLines="1"
                            android:text="JESOSY MAMONJY"
                            android:textAllCaps="true"
                            android:textColor="@color/primary_container"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_trakta_reader_top_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.14"
                            android:text="TRAKTA • M.A. DAOUD"
                            android:textAllCaps="true"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Font Size Toggle Action -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_trakta_reader_font"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/pill_btn_bg"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#EAE0E2"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_gravity="center"
                            android:contentDescription="Habe"
                            android:src="@drawable/ic_format_size"
                            app:tint="@color/primary_container" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- 2. SCROLLABLE TRAKTA CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/trakta_reader_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Bento Card (Cover + Metadata) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_eae0e2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <!-- Left Cover Block -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/card_reader_cover"
                            android:layout_width="82dp"
                            android:layout_height="114dp"
                            app:cardBackgroundColor="#351019"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="1dp"
                            app:strokeWidth="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <ImageView
                                    android:id="@+id/iv_reader_cover"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_trakta_cover_1" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:layout_gravity="bottom"
                                    android:background="@drawable/bg_trakta_cover_scrim"
                                    android:gravity="bottom|center_horizontal"
                                    android:orientation="vertical"
                                    android:padding="6dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:letterSpacing="0.06"
                                        android:text="M. A. DAOUD"
                                        android:textAllCaps="true"
                                        android:textColor="@color/white"
                                        android:textSize="8sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </FrameLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Right Info Block -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_trakta_tag_pill"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:letterSpacing="0.05"
                                    android:paddingStart="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp"
                                    android:text="TRAKTA"
                                    android:textAllCaps="true"
                                    android:textColor="@color/primary_container"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="1dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/tv_reader_number"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="N° 01"
                                    android:textColor="#8E8E93"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_reader_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Tena Misy ny Lanitra"
                                android:textColor="@color/primary_container"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_reader_author"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/plus_jakarta_sans"
                                android:text="Mpanoratra: M. A. DAOUD"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_check_circle" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:fontFamily="@font/plus_jakarta_sans"
                                    android:text="100% Offline"
                                    android:textColor="#2E7D32"
                                    android:textSize="11.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Main Teaching Content Bento Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_container_lowest"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/border_eae0e2"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tv_reader_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:lineSpacingExtra="7dp"
                            android:textColor="@color/on_surface"
                            android:textSize="15.5sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="20dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/border_eae0e2" />

                        <!-- Bottom Navigation Row (Previous / Next Trakta + Share) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_reader_prev_trakta"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/pill_btn_bg"
                                app:cardCornerRadius="999dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="14dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_chevron_left"
                                        app:tint="@color/primary_container" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="4dp"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="Teo aloha"
                                        android:textColor="@color/primary_container"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <Space
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_reader_share_trakta"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:layout_marginEnd="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/pill_btn_bg"
                                app:cardCornerRadius="19dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="Hizara"
                                    android:src="@drawable/ic_share"
                                    app:tint="@color/primary_container" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btn_reader_next_trakta"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="#781C2E"
                                app:cardCornerRadius="999dp"
                                app:cardElevation="1dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="14dp"
                                    android:paddingEnd="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/plus_jakarta_sans"
                                        android:text="Manaraka"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginStart="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_chevron_right"
                                        app:tint="@color/white" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Footer Motto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:text="« Ho voninahitr'Andriamanitra irery ihany »"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11.5sp"
                        android:textStyle="italic" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>
</FrameLayout>
