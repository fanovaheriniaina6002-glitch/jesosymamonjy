<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trakta_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient"
    android:clickable="true"
    android:focusable="true">

    <!-- Main Trakta List Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 1. TOP APP BAR / PILL HEADER (0% blur / 60 FPS Solid Bento) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="999dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_eae0e2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- Back Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_trakta_back"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/hikaroka_pill_bg"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="Miverina"
                            android:src="@drawable/ic_arrow_back_ios"
                            app:tint="@color/primary_container" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Brand Title & Subtitle -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.06"
                            android:text="JESOSY MAMONJY"
                            android:textAllCaps="true"
                            android:textColor="@color/primary_container"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/plus_jakarta_sans"
                            android:letterSpacing="0.14"
                            android:text="M.A. DAOUD"
                            android:textAllCaps="true"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="9.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Search Button -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_trakta_search"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="@color/hikaroka_pill_bg"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_gravity="center"
                            android:contentDescription="Tadiavo"
                            android:src="@drawable/ic_search"
                            app:tint="@color/primary_container" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Optional Inline Search Pill (Toggled by Search Button) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_trakta_search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="1dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary_container" />

                <EditText
                    android:id="@+id/et_trakta_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="Hitady trakta (oh: Lanitra, Paska...)"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/on_surface"
                    android:textColorHint="#8E8E93"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. MAIN SCROLLABLE CONTENT -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/trakta_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="116dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Section (Title + Subtitle) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="-0.02"
                        android:text="Trakta"
                        android:textColor="@color/primary_container"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Vakio ato ireo fampianarana nosoratan'ny Fr sy Sr Daoud"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Trakta Cards Stack List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_trakta_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Footer Motto & Safe Indicator -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:gravity="center"
                        android:text="« Ho voninahitr'Andriamanitra irery ihany »"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="11.5sp"
                        android:textStyle="italic" />

                    <View
                        android:layout_width="128dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_badge_dark_pill" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- ========================================================================= -->
    <!-- OFFLINE TRAKTA READER OVERLAY (Solid Bento 0% blur / 60 FPS)              -->
    <!-- ========================================================================= -->
    <LinearLayout
        android:id="@+id/trakta_reader_modal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen_gradient"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <!-- Reader Top Floating Pill Header -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="999dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border_eae0e2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_trakta_reader_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/pill_btn_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Hiverina"
                        android:src="@drawable/ic_arrow_back_ios"
                        app:tint="@color/primary_container" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tv_trakta_reader_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:letterSpacing="0.08"
                        android:text="TRAKTA N° 01"
                        android:textAllCaps="true"
                        android:textColor="@color/primary_container"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_trakta_reader_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="M. A. DAOUD • 100% OFFLINE"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Font Size A+ Toggle -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_trakta_reader_font"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/pill_btn_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Habe"
                        android:src="@drawable/ic_format_size"
                        app:tint="@color/primary_container" />
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reader Content Card -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/trakta_reader_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="26dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/border_eae0e2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:id="@+id/tv_trakta_reader_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans"
                        android:text="Tena Misy ny Lanitra"
                        android:textColor="@color/primary_container"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="48dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_section_indicator" />

                    <TextView
                        android:id="@+id/tv_trakta_reader_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:lineSpacingExtra="6dp"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</FrameLayout>
