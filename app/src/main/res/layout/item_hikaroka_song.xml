<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_hikaroka_song"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/hikaroka_pill_bg"
    app:strokeColor="@color/border_eae0e2"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Number Badge (w-12 h-12 rounded-full bg-primary-container text-on-primary) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="@color/primary_container"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/tv_song_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="112"
                android:textColor="@color/on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Center Content (flex-1 mx-3.5 min-w-0) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans"
                android:maxLines="1"
                android:text="NAHOANA NO MBOLA HIANDRY"
                android:textColor="@color/on_surface"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_song_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:text="“Nahoana no mbola hiandry? Avia amin'i Jesosy...”"
                android:textColor="@color/outline"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Favorite Button (w-10 h-10 rounded-full) -->
        <ImageButton
            android:id="@+id/btn_favorite_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tehirizo amin'ny hira tiako"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/outline" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
